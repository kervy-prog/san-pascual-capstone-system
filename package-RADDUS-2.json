{
  "name": "san-pascual-infrastructure-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the Brgy. San Pascual infrastructure complaint and service request management system.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "frontend": "node scripts/serve-frontend.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx scripts/seed-categories.ts && tsx scripts/create-admin.ts",
    "admin:seed": "tsx scripts/create-admin.ts",
    "categories:seed": "tsx scripts/seed-categories.ts",
    "test": "node scripts/e2e-system-test.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "exifr": "^7.1.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "prisma": "^6.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
