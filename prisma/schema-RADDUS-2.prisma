generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RESIDENT
  STAFF
  ADMIN
}

enum RequestType {
  COMPLAINT
  SERVICE_REQUEST
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResidentGender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum OfficialStatus {
  ACTIVE
  RETIRED
  NOT_ON_DUTY
}

enum MediaType {
  IMAGE
  VIDEO
}

model Resident {
  id                 String          @id @default(cuid())
  firstName          String
  lastName           String
  middleName         String?
  email              String          @unique
  phone              String?
  passwordHash       String
  role               UserRole        @default(RESIDENT)
  age                Int?
  gender             ResidentGender?
  birthDate          DateTime?
  nationality        String?
  address            String?
  barangay           String?
  municipality       String?
  province           String?
  residencyConfirmed Boolean         @default(false)
  privacyConsent     Boolean         @default(false)
  privacyConsentAt   DateTime?
  approvalStatus     ApprovalStatus  @default(PENDING)
  isVerified         Boolean         @default(false)
  isAdmin            Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  officialProfile BarangayOfficial?
  reports         InfrastructureReport[]
  requests        ServiceRequest[]
}

model BarangayOfficial {
  id                   String         @id @default(cuid())
  residentId           String         @unique
  resident             Resident       @relation(fields: [residentId], references: [id], onDelete: Cascade)
  designationPosition  String?
  contactNumber        String?
  status               OfficialStatus @default(ACTIVE)
  proofOfAppointment   String?
  identityVerification String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  actions BarangayAction[]
}

model InfrastructureCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  urgencyLevel String   @default("MEDIUM")
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports InfrastructureReport[]
}

model InfrastructureReport {
  id                    String                 @id @default(cuid())
  reportId              String?                @unique
  ticketNumber          String?                @unique
  residentId            String
  resident              Resident               @relation(fields: [residentId], references: [id], onDelete: Cascade)
  categoryId            String
  category              InfrastructureCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  exactLocationLandmark String
  descriptionOfHazard   String
  currentStatus         RequestStatus          @default(SUBMITTED)
  status                RequestStatus          @default(SUBMITTED)
  submitAnonymously     Boolean                @default(false)
  dateSubmitted         DateTime               @default(now())
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  media   ReportMedia[]
  actions BarangayAction[]
}

model ReportMedia {
  id        String               @id @default(cuid())
  reportId  String
  report    InfrastructureReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  filePath  String
  mediaType MediaType            @default(IMAGE)
  createdAt DateTime             @default(now())
}

model BarangayAction {
  id         String                @id @default(cuid())
  officialId String?
  official   BarangayOfficial?     @relation(fields: [officialId], references: [id], onDelete: SetNull)
  reportId   String?
  report     InfrastructureReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  actionType String?
  notes      String?
  createdAt  DateTime              @default(now())
}

model ServiceRequest {
  id            String        @id @default(cuid())
  referenceCode String        @unique
  type          RequestType
  category      String
  title         String
  description   String
  address       String
  barangay      String        @default("San Pascual")
  status        RequestStatus @default(SUBMITTED)
  priority      Int           @default(3)
  residentId    String
  resident      Resident      @relation(fields: [residentId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
